# ESP-IDF SDK configuration defaults for PDN firmware
# PlatformIO merges these into sdkconfig at build time.

# Match actual flash size on the ESP32-S3-DevKitM-1 (2 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"

# CPU at 240 MHz for responsive MQTT + LED animation
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS tick rate: 1 ms resolution for accurate haptic timing
CONFIG_FREERTOS_HZ=1000

# MQTT client buffer — large enough for protobuf status messages
CONFIG_MQTT_BUFFER_SIZE=1024

# Enable MQTT over TCP (no TLS required for local broker)
CONFIG_MQTT_TRANSPORT_TCP=y

# Enable the RMT peripheral (required by led_strip component)
CONFIG_SOC_RMT_SUPPORTED=y

# WiFi station mode
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
