# nanopb options for esp32_commander.proto
# Specifies static buffer sizes for string fields on the ESP32.
# These limits bound stack/RAM usage on the microcontroller.

MessageCmd.text         max_size:128
LedCmd.effect           max_size:32
HapticCmd.pattern       max_size:32
RawCmd.payload_json     max_size:512
StatusMsg.device_id     max_size:32
StatusMsg.firmware      max_size:16
StatusMsg.ip            max_size:16
